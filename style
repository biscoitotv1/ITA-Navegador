.ai-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 5000;
}

.ai-modal.show {
    display: flex;
}

.ai-card {
    width: 720px;
    max-width: 92%;
    height: 620px;
    max-height: 85vh;

    background: #ffffff;

    border-radius: 16px;

    box-shadow:
        0 25px 70px rgba(0,0,0,.35);

    display: flex;
    flex-direction: column;

    overflow: hidden;
}

.ai-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 16px 20px;

    border-bottom: 1px solid #e5e7eb;
}

.ai-header strong {
    display: block;
    font-size: 15px;
}

.ai-header small {
    color: #6b7280;
    font-size: 11px;
}

.ai-header button {
    border: none;
    background: transparent;

    font-size: 24px;

    cursor: pointer;

    color: #6b7280;
}

.ai-status {
    padding: 8px 20px;

    font-size: 11px;

    color: #6b7280;

    border-bottom: 1px solid #f0f0f0;
}

.ai-messages {
    flex: 1;

    overflow-y: auto;

    padding: 20px;

    display: flex;

    flex-direction: column;

    gap: 12px;
}

.ai-message {
    max-width: 85%;

    padding: 12px 15px;

    border-radius: 12px;

    font-size: 13px;

    line-height: 1.5;

    white-space: pre-wrap;
}

.ai-message.ai {
    background: #f1f3f5;

    color: #1f2937;

    align-self: flex-start;
}

.ai-message.user {
    background: #3b5bdb;

    color: white;

    align-self: flex-end;
}

.ai-input-area {
    display: flex;

    gap: 10px;

    padding: 12px;

    border-top: 1px solid #e5e7eb;
}

.ai-input-area textarea {
    flex: 1;

    resize: none;

    height: 45px;

    padding: 12px;

    border: 1px solid #d1d5db;

    border-radius: 10px;

    outline: none;

    font-family: inherit;

    font-size: 13px;
}

.ai-input-area textarea:focus {
    border-color: #3b5bdb;
}

.ai-input-area button {
    border: none;

    background: #3b5bdb;

    color: white;

    padding: 0 20px;

    border-radius: 10px;

    font-weight: 600;

    cursor: pointer;
}