{
  "name": "ita-navegador",
  "version": "1.0.0",
  "private": true,
  "description": "ITA Navegador - app desktop (Electron) + site (Next.js na Vercel)",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "app": "cmd /c \"set ELECTRON_RUN_AS_NODE=& electron .\"",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test": "node validate-project.js",
    "test:agent": "node validate-agent.js"
  },
  "author": "ITA Games Studios",
  "license": "MIT",
  "build": {
    "appId": "top.itabrowser.app",
    "productName": "ITA Navegador",
    "directories": {
      "output": "release",
      "buildResources": "public/brand"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!app/**",
      "!scripts/**",
      "!node_modules/next/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/three/**",
      "!node_modules/@next/**"
    ],
    "win": {
      "icon": "public/brand/ita-logo.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ITA Navegador",
      "artifactName": "ITA-Navegador-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.24",
    "typescript": "^5.9.2"
  }
}
