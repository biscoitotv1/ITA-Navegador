{
  "name": "ita-navegador",
  "version": "1.0.0",
  "private": true,
  "description": "ITA Navegador - app desktop (Electron) com internet real (sem proxy e sem servidor local)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "app": "electron .",
    "lint": "eslint .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test": "node validate-project.js",
    "test:agent": "node validate-agent.js",
    "test:portal": "electron Scripts/smoke-portal.js"
  },
  "author": "ITA Games Studios",
  "license": "MIT",
  "build": {
    "appId": "top.itabrowser.app",
    "productName": "ITA Navegador",
    "directories": {
      "output": "release",
      "buildResources": "public/brand"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "home.html",
      "ita-ai.js",
      "ita-agent-ui.js",
      "src/**/*",
      "site/**/*",
      "public/brand/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/brand/ita-logo.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ITA Navegador",
      "artifactName": "ITA-Navegador-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "ITA Browser",
        "schemes": ["itabrowser"]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0"
  }
}
