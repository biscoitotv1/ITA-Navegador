{
  "name": "ita-navegador",
  "version": "1.0.7",
  "private": true,
  "description": "ITA Navegador - app desktop (Electron) com internet real (sem proxy e sem servidor local)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "app": "electron .",
    "lint": "eslint .",
    "dist": "electron-builder --win",
    "predist": "node Scripts/bump-version.js",
    "release": "node Scripts/bump-version.js && electron-builder --win --publish always",
    "publish": "electron-builder --win --publish always",
    "dist:dir": "electron-builder --win --dir",
    "test": "node validate-project.js",
    "test:agent": "node validate-agent.js"
  },
  "author": "ITA Games Studios",
  "license": "MIT",
  "build": {
    "appId": "top.itabrowser.app",
    "productName": "ITA Navegador",
    "directories": {
      "output": "release",
      "buildResources": "public/brand"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "ita-ai.js",
      "ita-agent-ui.js",
      "src/**/*",
      "public/brand/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/brand/ita-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ITA Navegador",
      "artifactName": "ITA-Navegador-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "ITA Browser",
        "schemes": [
          "itabrowser"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "biscoitotv1",
      "repo": "ITA-Navegador"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0"
  }
}
